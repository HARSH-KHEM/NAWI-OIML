# Application Environment
ENVIRONMENT=development
PROJECT_NAME="SIH26035 OIML R-76 Platform"
API_V1_STR=/api/v1

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sih26035_metrology

# Optional: Full Database URL override (e.g., when using Docker, Cloud SQL, or external provider)
# If left commented out, DATABASE_URL is constructed from POSTGRES_* variables above.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sih26035_metrology

# Test Database URL (used by pytest if provided; defaults to sqlite:///:memory: for isolation)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sih26035_test
